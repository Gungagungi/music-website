# Dependencies
node_modules/
.npm/

# Next.js
app/.next/
app/out/
app/next-env.d.ts
# `npm run build` also builds from the root in some local flows; the only
# build that matters goes through app/.next/ above.
/.next/

# Database commands compiled for the production image (npm run db:build)
app/dist/

# Backups produced by scripts/sauvegarde.sh
sauvegardes/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/reports/
app/reports/
app/.stryker-tmp/
e2e/.auth/
e2e/.cache/
# storageState left behind by a Playwright run started from the root
/.auth/

# k6 — the directory is kept, its content is not
perf/results/*
!perf/results/.gitkeep

# Build & tooling caches
*.tsbuildinfo
.eslintcache

# Environment
.env
.env.local
.env*.local
# Production stack environment, when trying it from a machine that already has a
# development .env. The .example files, however, are versioned.
.env.production
.env.production.bak
# Pre-production secrets (npm run preprod:env).
.env.preprod

# OS / editors
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Local CI monitoring, not versioned
scratchpad/

# Agent instructions, generated by `next dev`
#
# Next rewrites them on every start (see
# node_modules/next/dist/server/lib/generate-agent-files.js): deleting them only
# brings them back. They describe the installed Next version, not this
# repository — versioning them would make their content diverge from the
# dependency at the next upgrade, silently.
app/AGENTS.md
app/CLAUDE.md
__pycache__/
