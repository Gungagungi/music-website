# Dependencies
node_modules/
.npm/

# Next.js
app/.next/
app/out/
app/next-env.d.ts
# `npm run build` construit aussi depuis la racine dans certains flux locaux ;
# le seul build versionné passe par app/.next/ ci-dessus.
/.next/

# Commandes de base compilées pour l'image de production (npm run db:build)
app/dist/

# Sauvegardes produites par scripts/sauvegarde.sh
sauvegardes/

# Playwright
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/
e2e/reports/
app/reports/
app/.stryker-tmp/
e2e/.auth/
e2e/.cache/
# storageState laissé par un run Playwright lancé depuis la racine
/.auth/

# k6 — le dossier est conservé, son contenu non
perf/results/*
!perf/results/.gitkeep

# Build & tooling caches
*.tsbuildinfo
.eslintcache

# Environment
.env
.env.local
.env*.local
# Environnement de la pile de production, quand on l'essaie depuis un poste qui a
# déjà un .env de développement. Les .example, eux, sont versionnés.
.env.production
.env.production.bak

# OS / editors
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Logs
*.log
npm-debug.log*

# Surveillance CI locale, non versionnée
scratchpad/

# Instructions pour agents, générées par `next dev`
#
# Next les réécrit à chaque démarrage (voir
# node_modules/next/dist/server/lib/generate-agent-files.js) : les supprimer ne
# fait que les ramener. Elles décrivent la version de Next installée, pas ce
# dépôt — les versionner ferait diverger leur contenu de la dépendance dès la
# prochaine montée de version, silencieusement.
app/AGENTS.md
app/CLAUDE.md
__pycache__/
