# Configuration de la pré-production (docker-compose.preprod.yml).
#
#   npm run preprod:env      → .env.preprod, secrets tirés au hasard
#
# Les trois valeurs sont de purs secrets : scripts/preparer-env.mjs les remplit,
# aucune n'appelle de décision humaine. Le domaine et l'accès, eux, sont portés
# par le Caddy de la production — voir la section « Pré-production » de
# .env.production.example.

# Générer : openssl rand -hex 32 — même règle qu'en production, ce mot de passe
# traverse DATABASE_URL.
POSTGRES_PASSWORD=

# Distincte de celle de la production. Une clé partagée rendrait une session
# ouverte sur la pré-prod valable sur la boutique, et la pré-prod tourne en mode
# test, avec ses comptes semés aux mots de passe publiés dans ce dépôt.
AUTH_SECRET=

# Jeton des endpoints /api/test/*, à redonner à la suite Playwright :
#   BASE_URL=https://preprod.… TEST_API_TOKEN=<cette valeur> PREPROD_ACCESS_KEY=… npx playwright test
TEST_API_TOKEN=
