{
  "name": "music-website",
  "version": "1.0.0",
  "private": true,
  "description": "Fretline — a fictional guitar & bass e-commerce demo site with a full QA automation framework",
  "license": "MIT",
  "workspaces": [
    "app",
    "e2e"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev -w app",
    "build": "npm run build -w app",
    "start": "npm run start -w app",
    "lint": "npm run lint -w app && npm run lint -w e2e",
    "typecheck": "npm run typecheck -w app && npm run typecheck -w e2e",
    "check:catalog": "npm run check:catalog -w app",
    "test": "npm run test -w e2e",
    "test:smoke": "npm run test:smoke -w e2e",
    "test:unit": "npm run test:unit -w app",
    "test:mutation": "npm run test:mutation -w app",
    "test:ui": "npm run test:ui -w e2e",
    "test:api": "npm run test:api -w e2e",
    "test:a11y": "npm run test:a11y -w e2e",
    "test:visual": "npm run test:visual -w e2e",
    "report": "npm run report -w e2e",
    "docs:html": "node scripts/rendre-docs.mjs",
    "tendance": "node scripts/rendre-tendance.mjs",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:nuke": "docker compose -f docker-compose.dev.yml down -v",
    "db:generate": "npm run db:generate -w app",
    "db:migrate": "npm run db:migrate -w app",
    "db:seed": "npm run db:seed -w app",
    "db:reset": "npm run db:reset -w app",
    "db:purge": "npm run db:purge -w app",
    "db:build": "npm run db:build -w app",
    "db:env": "node scripts/preparer-env.mjs",
    "db:setup": "npm run db:env && npm run db:up && npm run db:migrate && npm run db:seed",
    "prod:env": "node scripts/preparer-env.mjs --production",
    "prod:config": "docker compose --env-file .env.production config -q && echo \"compose valide\"",
    "prod:verifier": "./scripts/verifier-deploiement.sh",
    "prod:persistance": "COMPOSE=\"docker compose --env-file .env.production\" ./scripts/verifier-persistance.sh http://localhost --jaccepte",
    "prod:up": "npm run prod:env && docker compose --env-file .env.production up -d --build",
    "prod:logs": "docker compose --env-file .env.production logs -f",
    "prod:down": "docker compose --env-file .env.production down",
    "prod:nuke": "docker compose --env-file .env.production down --volumes",
    "perf:smoke": "k6 run perf/smoke.js",
    "perf:load": "k6 run perf/load.js",
    "perf:baseline": "node scripts/enregistrer-baseline.mjs",
    "trace": "npm run trace -w e2e",
    "openapi": "npm run openapi -w e2e"
  },
  "devDependencies": {
    "marked": "^18.0.10"
  }
}
