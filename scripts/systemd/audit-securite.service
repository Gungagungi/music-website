# Recurring security audit — see scripts/audit-securite.py
#
# Installation:
#   sudo cp scripts/systemd/audit-securite.* /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now audit-securite.timer
#
# The unit runs as the `debian` account, not as root: it needs the docker group
# (trivy queries the daemon) and `sudo -n` for the only two privileged reads it
# depends on, `sshd -T` and `nft list ruleset`. Granting it full root for those
# two commands would be paying a very high price for an audit that, by
# definition, changes nothing.

[Unit]
Description=Fretline security audit (host, images, end of support, repository, public target)
Documentation=file:/home/debian/dev/pro/music-website/docs/security.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=debian
Group=debian
SupplementaryGroups=docker
WorkingDirectory=/home/debian/dev/pro/music-website

# The target is read from .env.production rather than hard-coded here: the
# domain is already there, and two copies of the same address always end up
# diverging.
EnvironmentFile=/home/debian/dev/pro/music-website/.env.production

# The JSON report is timestamped and kept; `dernier.json` always points to the
# latest run, so that an external check does not have to guess a name.
#
# The notification is chained here and not as `ExecStartPost=`, which would
# nevertheless be its natural place. systemd does not run `ExecStartPost` when
# `ExecStart` exits with an error — and the audit exits with 1 precisely when a
# finding exceeds the threshold, that is, in the only case worth alerting on.
# The notification would only ever have been sent on days when all was well.
#
# The `|| true` keeps the same logic the other way round: the audit's exit
# code, preserved in $$CODE, decides the unit's state. A notification server
# that is down is an operations incident, not a security verdict, and it must
# neither turn this unit red nor green.
ExecStart=/bin/sh -c '\
  REP="$${HOME}/.local/share/audit-securite"; \
  mkdir -p "$$REP"; \
  HORODATAGE=$$(date -u +%%Y-%%m-%%dT%%H%%M%%SZ); \
  /home/debian/dev/pro/music-website/scripts/audit-securite.py \
    --cible "https://$${FRETLINE_DOMAIN}" \
    --seuil eleve \
    --sortie "$$REP/audit-$${HORODATAGE}.json"; \
  CODE=$$?; \
  ln -sf "$$REP/audit-$${HORODATAGE}.json" "$$REP/dernier.json"; \
  find "$$REP" -name "audit-*.json" -mtime +90 -delete; \
  /home/debian/dev/pro/music-website/scripts/notifier-audit.py --rapports "$$REP" || true; \
  exit $$CODE'

# The nuclei scan is throttled to 20 requests per second but goes through more
# than thirteen thousand templates: one hour is generous, and the bound mostly
# exists so that a stuck run does not overlap the next one.
TimeoutStartSec=3600

# The audit changes nothing on the system: it reads files, queries services and
# sends HTTP requests. It does, however, write a lot into the home directory —
# its report, but also the caches of trivy (CVE database), nuclei and npm.
#
# Hence `ProtectSystem=full` and not `strict`. `strict` makes the whole home
# read-only and requires every `ReadWritePaths` entry to already exist at
# startup: the unit failed with 226/NAMESPACE before running anything, because
# the reports directory had not been created yet. Listing the four caches
# instead would be a list to maintain at the pace of the tools, for hardening
# that protects little more: /usr, /boot and /etc stay read-only in both cases,
# and that is where what an audit must never be able to modify lives.
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true

# A failure is expected and informative: it means a finding exceeded the
# threshold. `systemctl status audit-securite` and the journal show it, which is
# enough on a single-operator machine.
StandardOutput=journal
StandardError=journal
