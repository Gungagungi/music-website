# Security audit schedule.
#
# 04:00 UTC: after the CI self-healing agent (03:00) and after the
# `unattended-upgrades` window, so that the "pending updates" check judges an
# already refreshed system rather than the previous day's state.

[Unit]
Description=Fretline security audit, daily
Documentation=file:/home/debian/dev/pro/music-website/docs/security.md

[Timer]
OnCalendar=*-*-* 04:00:00 UTC

# Catches up on a missed run if the machine was off at the scheduled time. An
# audit skipped without anyone knowing is an audit that serves no purpose.
Persistent=true

# Spreads the start over ten minutes. Without it, the nuclei scan starts at the
# exact same second as everything else scheduled on the hour.
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
