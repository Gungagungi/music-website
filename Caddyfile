# Portfolio (~/dev/pro/portfolio): the landing page on the bare domain, a
# static site presenting the other projects. Same arrangement as the two blocks
# above: its stack joins `fretline-edge` under the `portfolio-web` alias, and
# with that stack down this block answers 502 and nothing else moves.
#
# Same default pattern: plain HTTP on 8086, inside the container only,
# without asking Let's Encrypt for anything.
{$PORTFOLIO_DOMAIN::8086} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy portfolio-web:80

	log {
		output stdout
		format console
	}
}

# `www.` sends visitors to the bare domain, so the portfolio lives at a single
# address. A variable of its own rather than `www.{$PORTFOLIO_DOMAIN}`, for the
# same reason as the analytics block: `www.:8086` is not an address.
{$PORTFOLIO_WWW_DOMAIN::8087} {
	redir https://{$PORTFOLIO_DOMAIN}{uri} permanent
}

# Former addresses, from before the projects moved to subdomains of the
# portfolio domain. Each one sends its visitors to the address that replaced
# it, so links already sent — e-mails, bookmarks, a CV — keep working.
#
# 308 rather than `permanent` (301): a 301 lets the client turn a POST into a
# GET, and the tracker cached in pages served before the move still posts to
# the old analytics host.
#
# The target is picked from the first label, not from a full host name: the
# list of addresses then lives in a single variable, and the host matching no
# label is the former shop address, which had none.
#
# Carnet 190D is redirected for browsers only. Its mobile app authenticates
# with `Authorization: Bearer`, and HTTP clients drop that header when a
# redirect changes host: a build targeting a former address would be logged
# out on its next call. None is in circulation — no EAS build was ever made
# before the move — so the redirect is safe; should one exist, the address
# goes back into CARNET_DOMAIN as a second name instead.
#
# Same default pattern as the blocks above: plain HTTP on 8088, inside the
# container only.
{$LEGACY_DOMAINS::8088} {
	map {host} {legacy_target} {
		~^analytics\. {$FRETLINE_ANALYTICS_DOMAIN}
		~^alertes\. {$FRETLINE_NTFY_DOMAIN}
		~^preprod\. {$FRETLINE_PREPROD_DOMAIN}
		~^carnet\. {$CARNET_DOMAIN}
		default {$FRETLINE_DOMAIN}
	}
	redir https://{legacy_target}{uri} 308
}

# The two Godot games (mecha-survivant-2, hells-survivant-2), reachable straight
# from the server's IP address, in HTTPS:
#   https://<ip>/mecha-survivant-2/
#   https://<ip>/hells-survivant-2/
#
# Relayed, not hosted: the games live on GitHub Pages (~/dev/perso/games), whose
# CI builds the Godot exports on every push. Proxying keeps a single build and
# a single source of truth; the VPS only carries the bytes. Both exports are
# single-threaded, so no COOP/COEP headers are needed on top of what Pages
# sends.
#
# The `tls` settings (six-day IP certificate) are imported only when
# GAMES_IP_ADDRESS is set: written inline, they would turn the `:8089` default
# into a catch-all policy and put every other site of this Caddy on six-day
# certificates. See the `games-ip-tls` snippet and the global options at the
# top of this file.
#
# One IP, one root: the root lists the two games, anything else is a 404 so
# the rest of the Pages site does not leak out under the IP.
{$GAMES_IP_ADDRESS::8089} {
	{$GAMES_IP_TLS}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Pages would answer these itself, but with a redirect to its own domain,
	# which would change the address bar.
	redir /mecha-survivant-2 /mecha-survivant-2/ permanent
	redir /hells-survivant-2 /hells-survivant-2/ permanent

	@jeux path /mecha-survivant-2/* /hells-survivant-2/*
	handle @jeux {
		# Over HTTPS, Caddy already sends the upstream's own Host, which is
		# what Pages routes on.
		reverse_proxy https://jeux.lambertdeharosanchez.com
	}

	handle / {
		header Content-Type "text/html; charset=utf-8"
		respond `<!doctype html>
<html lang="fr">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jeux</title>
<body style="font-family:system-ui,sans-serif;max-width:32rem;margin:3rem auto;padding:0 1rem;line-height:1.6">
<h1>Jeux</h1>
<ul>
<li><a href="/mecha-survivant-2/">Mecha Survivant 2</a></li>
<li><a href="/hells-survivant-2/">Hell's Survivant 2</a></li>
</ul>
</body>
</html>
`
	}

	handle {
		respond 404
	}

	log {
		output stdout
		format console
	}
}
