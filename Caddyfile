# Reverse proxy and TLS termination.
#
# Caddy obtains and renews the certificate on its own as soon as FRETLINE_DOMAIN
# is a public domain name pointing at this server. For a local trial, set
# FRETLINE_DOMAIN=:80 in .env: Caddy then serves plain HTTP without asking
# Let's Encrypt for anything.
#
# Traefik would do the same, but by exposing the Docker socket to the proxy;
# that only pays off from a dozen or so services to discover dynamically.

{$FRETLINE_DOMAIN} {
	encode zstd gzip

	header {
		# HSTS: Caddy already serves HTTPS, so the plain-text version might as
		# well be forbidden for subsequent visits.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# No X-Frame-Options: `frame-ancestors` replaces it and covers more
		# cases.
		#
		# No Content-Security-Policy either, and that is deliberate: the full
		# policy is set by the application (app/src/proxy.ts), because it
		# carries a nonce recomputed on every request. Two headers with the
		# same name do not replace each other — the browser enforces the
		# intersection of both — and a `frame-ancestors 'none'` frozen here
		# would go unnoticed until the day it contradicted the other one.
		-Server
	}

	# `prod-app`, et non `app` : voir l'alias dans docker-compose.yml. Ce Caddy
	# est aussi branché sur `fretline-edge`, où le conteneur de pré-production
	# répond au nom `app`.
	reverse_proxy prod-app:3000 {
		health_uri /api/health
		health_interval 15s
	}

	log {
		output stdout
		format console
	}
}

# Matomo interface, on its own domain name.
#
# A dedicated subdomain rather than a path under the site: Matomo is a full PHP
# application that rewrites its own URLs and sets its session cookies on the
# root. Mounting it under /analytics would mean rewriting its links one by one,
# and the first one missed would end in a blank page.
#
# A variable separate from FRETLINE_DOMAIN, not `analytics.{$FRETLINE_DOMAIN}`:
# a local trial sets FRETLINE_DOMAIN=:80, and `analytics.:80` is not an
# address. The default below serves exactly that case — Caddy then listens in
# plain HTTP on 8081, without asking Let's Encrypt for anything.
{$FRETLINE_ANALYTICS_DOMAIN::8081} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	reverse_proxy matomo:80

	log {
		output stdout
		format console
	}
}

# ntfy notification server, recipient of the security audit alerts.
#
# Same pattern as the Matomo block: dedicated subdomain, and a plain-HTTP
# default on 8082 for local trials, where the port stays on loopback.
{$FRETLINE_NTFY_DOMAIN::8082} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# No `encode` here, unlike the other two blocks: an ntfy subscription is an
	# event stream that stays open, and a compression layer buffers — the
	# message then only arrives once the buffer is full, that is, with the next
	# alert.
	reverse_proxy ntfy:80 {
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}

# Pre-production: the branch deployed by scripts/deployer-preprod.sh.
#
# Served by this Caddy rather than a second one: 80 and 443 are already taken,
# and the certificates live here. The application lives in another Compose
# stack (docker-compose.preprod.yml), reached through the `fretline-edge`
# network under the `preprod-app` alias. With pre-production down, this block
# answers 502 and nothing else moves.
#
# Same default pattern as Matomo and ntfy: plain HTTP on 8083, on loopback,
# without asking Let's Encrypt for anything.
{$FRETLINE_PREPROD_DOMAIN::8083} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# An indexed pre-production ends up as a search result next to the
		# shop, with its test carts and seeded accounts.
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	# Key-based exemption, for the Playwright suite run against pre-production.
	# Basic auth occupies the `Authorization` header, which the API suite
	# already fills with its `Bearer`: the two cannot coexist on one request.
	#
	# An expression rather than a `header` matcher: without PREPROD_ACCESS_KEY,
	# the substitution yields an empty string, and an empty or missing header
	# must never pass for the right key. The `!= ""` is what closes that door.
	@verrouille not expression `{header.X-Fretline-Preprod} != "" && {header.X-Fretline-Preprod} == "{$PREPROD_ACCESS_KEY}"`

	# Locked-down defaults, not empty ones: an empty hash would make the whole
	# configuration fail — and take down with it the shop, served by this same
	# Caddy. The default is the hash of a randomly drawn, then discarded string:
	# Caddy starts (CI, local trial) and nobody gets in.
	basic_auth @verrouille {
		{$PREPROD_BASIC_AUTH_USER:fretline} {$PREPROD_BASIC_AUTH_HASH:$2a$14$Bcoh63tinCQaAAH8qPR4teL49GuNTsmWW1dhmSueQ5xHWLqKMKI6e}
	}

	reverse_proxy preprod-app:3000

	log {
		output stdout
		format console
	}
}

# Carnet 190D: a separate project (~/dev/pro/mercedes) hosted on the same VPS.
#
# Served by this Caddy for the same reason as pre-production: 80 and 443 are
# already taken, and the certificates live here. The application lives in its
# own Compose stack and joins `fretline-edge` under the `carnet-app` alias —
# never `app`, which pre-production also answers to on that network. With the
# carnet stack down, this block answers 502 and nothing else moves.
#
# Same default pattern as the blocks above: plain HTTP on 8084, inside the
# container only, without asking Let's Encrypt for anything.
{$CARNET_DOMAIN::8084} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy carnet-app:3000 {
		health_uri /api/health
		health_interval 15s
	}

	log {
		output stdout
		format console
	}
}

