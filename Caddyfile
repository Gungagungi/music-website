# Reverse proxy et terminaison TLS.
#
# Caddy obtient et renouvelle le certificat tout seul dès que FRETLINE_DOMAIN est
# un nom de domaine public pointant vers ce serveur. Pour un essai local, mettre
# FRETLINE_DOMAIN=:80 dans .env : Caddy sert alors en clair sans rien demander à
# Let's Encrypt.
#
# Traefik ferait la même chose, mais en exposant le socket Docker au proxy ; ça ne
# se rentabilise qu'à partir d'une dizaine de services à découvrir dynamiquement.

{$FRETLINE_DOMAIN} {
	encode zstd gzip

	header {
		# HSTS : Caddy sert déjà en HTTPS, autant interdire la version en clair
		# pour les visites suivantes.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Pas de X-Frame-Options : `frame-ancestors` le remplace et couvre plus
		# de cas.
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	reverse_proxy app:3000 {
		health_uri /api/health
		health_interval 15s
	}

	log {
		output stdout
		format console
	}
}

# Interface Matomo, sur son propre nom de domaine.
#
# Un sous-domaine dédié plutôt qu'un chemin sous le site : Matomo est une
# application PHP complète, qui réécrit ses propres URL et pose ses cookies de
# session sur la racine. La monter sous /analytics obligerait à réécrire ses
# liens un par un, et le premier oubli se solderait par une page blanche.
#
# Variable distincte de FRETLINE_DOMAIN, et non `analytics.{$FRETLINE_DOMAIN}` :
# un essai local met FRETLINE_DOMAIN=:80, et `analytics.:80` n'est pas une
# adresse. Le défaut ci-dessous sert exactement ce cas — Caddy écoute alors en
# clair sur 8081, sans rien demander à Let's Encrypt.
{$FRETLINE_ANALYTICS_DOMAIN::8081} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	reverse_proxy matomo:80

	log {
		output stdout
		format console
	}
}
