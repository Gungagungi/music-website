# Copier vers .env pour le développement local :
#   cp .env.example .env
#
# Les valeurs ci-dessous correspondent à docker-compose.dev.yml et fonctionnent
# telles quelles. Aucune n'est un secret réel.

# --- Base de données -------------------------------------------------------
DATABASE_URL=postgresql://fretline:fretline@localhost:5432/fretline
# DATABASE_POOL_MAX=10

# --- Authentification ------------------------------------------------------
# Obligatoire en production : le serveur refuse de démarrer sans. En dev et en
# test, un défaut en dur prend le relais pour que `npm test` fonctionne sans .env.
# Générer avec : openssl rand -base64 48
# AUTH_SECRET=

# --- Mode test -------------------------------------------------------------
# ATTENTION : ces deux variables ouvrent /api/test/{reset,seed,state}, qui
# effacent et réécrivent la base. Elles ne doivent JAMAIS être définies en
# production. Le déploiement vérifie que GET /api/test/state répond 404.
# Playwright les injecte lui-même — inutile de les mettre ici pour lancer la suite.
# E2E_TEST_MODE=1
# TEST_API_TOKEN=fretline-e2e-token

# --- Défauts semés ---------------------------------------------------------
# Active les trois défauts délibérés (voir CLAUDE.md). NEXT_PUBLIC_SEED_BUGS est
# figé au build : changer sa valeur impose de rebuilder, pas seulement de
# redémarrer le serveur.
# SEED_BUGS=1
# NEXT_PUBLIC_SEED_BUGS=1
