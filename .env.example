# Copy to .env for local development:
#   cp .env.example .env
#
# The values below match docker-compose.dev.yml and work as they are. None of
# them is a real secret.

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://fretline:fretline@localhost:5432/fretline
# DATABASE_POOL_MAX=10

# --- Authentication --------------------------------------------------------
# Session signing key.
#
# `npm run db:env` appends one, randomly drawn, to the end of this file once it
# has been copied — there is deliberately none here: a clear-text value in a
# versioned file ends up copied onto a server one day.
#
# It is only required for a deployment (NODE_ENV=production without
# E2E_TEST_MODE); the test suite and `npm run dev` rely on a hard-coded default,
# so that `npm test` works without a .env.
# AUTH_SECRET=

# --- Test mode -------------------------------------------------------------
# WARNING: these two variables open /api/test/{reset,seed,state}, which wipe
# and rewrite the database. They must NEVER be set in production. The
# deployment checks that GET /api/test/state answers 404.
# Playwright injects them itself — no need to set them here to run the suite.
# E2E_TEST_MODE=1
# TEST_API_TOKEN=fretline-e2e-token

# --- Seeded defects --------------------------------------------------------
# Enables the three deliberate defects (see CLAUDE.md). NEXT_PUBLIC_SEED_BUGS is
# frozen at build time: changing its value requires a rebuild, not just a server
# restart.
# SEED_BUGS=1
# NEXT_PUBLIC_SEED_BUGS=1
